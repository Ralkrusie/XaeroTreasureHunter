{
    "schemaVersion": 1,
    "id": "treasurehunter",
    "version": "${version}",
    "name": "Xaero TreasureHunter",
    "description": "客户端识别战利品容器与兴趣方块，生成 Xaero 临时路径点，支持来源筛选、免扫描区域和 Mod Menu 设置入口。",
    "authors": [
        "Ralkrusie"
    ],
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.treasurehunter.TreasureHunterMod"
        ],
        "modmenu": [
            "com.treasurehunter.integration.ModMenuIntegration"
        ]
    },
    "mixins": ["treasurehunter.mixins.json"],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    },
    "recommends": {
        "xaerominimap": "*",
        "xaeroworldmap": "*"
    }
}
